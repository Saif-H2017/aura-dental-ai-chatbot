# LONDON DENTAL SURGEON AI CHATBOT ENVIRONMENT CONFIGURATION

PORT=3000

# MODE: Set to 'demo' for instant full zero-config demonstration, or 'production' for live Google/Twilio integration
APP_MODE=demo

# GEMINI API KEY (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# GOOGLE SERVICE ACCOUNT CONFIGURATION (For 24/7 Google Calendar & Sheets without weekly OAuth expiration)
# Download Service Account JSON key from Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=dental-bot@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary_or_dental_calendar_id@group.calendar.google.com
GOOGLE_SPREADSHEET_ID=your_google_sheet_id_here

# CLINIC & SURGEON DETAILS
CLINIC_NAME="Harley Street Dental Care London"
SURGEON_NAME="Dr. Alexander Wright, BDS"
SURGEON_PHONE="+447911123456"
SURGEON_EMAIL="dr.wright@harleystdental.co.uk"

# TWILIO MOBILE NOTIFICATIONS (Doctor SMS & Patient WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+441234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+441234567890

# EMAIL CONFIRMATIONS (SMTP via Gmail or SendGrid/Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clinic.notifications@gmail.com
SMTP_PASS=your_app_password_here
